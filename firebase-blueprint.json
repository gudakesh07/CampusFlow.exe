{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the CampusFlow platform (student, faculty, or admin)",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "faculty", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role", "createdAt"]
    },
    "Course": {
      "title": "Course",
      "description": "An academic course",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" },
        "facultyId": { "type": "string" },
        "students": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "code", "facultyId", "createdAt"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "An assignment for a course",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "dueDate": { "type": "string" },
        "facultyId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["courseId", "title", "dueDate", "facultyId", "createdAt"]
    },
    "Submission": {
      "title": "Submission",
      "description": "A student's submission for an assignment",
      "type": "object",
      "properties": {
        "assignmentId": { "type": "string" },
        "studentId": { "type": "string" },
        "contentUrl": { "type": "string" },
        "submittedAt": { "type": "string" },
        "grade": { "type": "number" }
      },
      "required": ["assignmentId", "studentId", "contentUrl", "submittedAt"]
    },
    "Group": {
      "title": "Group",
      "description": "A chat group that users can join via link",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "memberCount": { "type": "number" }
      },
      "required": ["name", "createdBy", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A message in a chat group",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "timestamp": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["text", "senderId", "senderName", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Stores course details."
    },
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Stores assignments created by faculty."
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/Submission" },
      "description": "Stores assignment submissions by students."
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/Group" },
      "description": "Stores chat groups."
    },
    "/groups/{groupId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Stores messages within a group."
    }
  }
}
